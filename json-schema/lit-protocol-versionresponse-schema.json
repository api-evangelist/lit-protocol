{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/VersionResponse",
  "title": "VersionResponse",
  "type": "object",
  "required": [
    "commit_version",
    "name",
    "submodule_versions",
    "version"
  ],
