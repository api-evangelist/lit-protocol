    "version": {
      "type": "string"
    },
    "commit_version": {
      "type": "string"
    },
    "submodule_versions": {
      "type": "array",
      "items": {
        "type": "array",
        "items": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "maxItems": 2,
        "minItems": 2
      }
    }
  }
}